{
  "name": "masaustu-agent",
  "version": "1.0.0",
  "description": "Yerel LLM ile calisan masaustu agent - dosya, terminal, sistem ve web araclariyla",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/generate-icon.js",
    "test": "node scripts/test-remote.js && electron scripts/test-remote-integration.js",
    "test:remote": "node scripts/test-remote.js",
    "test:remote:e2e": "electron scripts/test-remote-integration.js",
    "prebuild": "npm run icon",
    "build": "electron-builder",
    "build:mac": "npm run icon && electron-builder --mac",
    "build:win": "npm run icon && electron-builder --win"
  },
  "keywords": [
    "agent",
    "electron",
    "ollama",
    "local-llm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.masaustuagent",
    "productName": "Masaustu Agent",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "identity": null
    }
  }
}
